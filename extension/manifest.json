{
  "manifest_version": 3,
  "name": "YTM Control",
  "version": "0.2.0",
  "description": "Atalhos para o YouTube Music: curtir, adicionar a playlists e mais.",
  "key": "",
  "permissions": [
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "YTM Control: configurar atalhos",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "commands": {
    "like": {
      "description": "Curtir / descurtir a música atual"
    },
    "dislike": {
      "description": "Marcar \"não gostei\""
    },
    "pick-playlist": {
      "description": "Abrir seletor de playlist"
    },
    "play-pause": {
      "description": "Tocar / pausar"
    },
    "next": {
      "description": "Próxima música"
    },
    "previous": {
      "description": "Música anterior"
    },
    "slot-1": {
      "description": "Adicionar à playlist rápida 1"
    },
    "slot-2": {
      "description": "Adicionar à playlist rápida 2"
    },
    "slot-3": {
      "description": "Adicionar à playlist rápida 3"
    },
    "slot-4": {
      "description": "Adicionar à playlist rápida 4"
    },
    "slot-5": {
      "description": "Adicionar à playlist rápida 5"
    },
    "slot-6": {
      "description": "Adicionar à playlist rápida 6"
    },
    "slot-7": {
      "description": "Adicionar à playlist rápida 7"
    },
    "slot-8": {
      "description": "Adicionar à playlist rápida 8"
    },
    "slot-9": {
      "description": "Adicionar à playlist rápida 9"
    },
    "slot-10": {
      "description": "Adicionar à playlist rápida 10"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
