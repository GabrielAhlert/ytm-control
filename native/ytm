#!/usr/bin/env python3
"""ytm: controla o YouTube Music aberto no Chrome (via extensão YTM Control).

O mesmo arquivo tem dois papéis:
  * ponte de native messaging: o Chrome o executa passando a origem da extensão;
    ele escuta num socket Unix local e repassa os pedidos para a extensão;
  * CLI: `ytm like`, `ytm add "Playlist"` etc. conversam com esse socket.
"""
import argparse
import itertools
import json
import os
import shutil
import socket
import struct
import subprocess
import sys
import threading

SOCKET_PATH = os.environ.get("YTM_SOCKET") or os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "ytm-control.sock")
TIMEOUT = 15


# ---------- Ponte (executada pelo Chrome) ----------

def run_bridge():
    out_lock = threading.Lock()
    pending = {}
    ids = itertools.count(1)
    bound = []  # inode do socket que esta ponte criou

    def send_to_chrome(msg):
        data = json.dumps(msg).encode()
        with out_lock:
            sys.stdout.buffer.write(struct.pack("<I", len(data)) + data)
            sys.stdout.buffer.flush()

    def read_from_chrome():
        while True:
            header = sys.stdin.buffer.read(4)
            if len(header) < 4:
                break
            msg = json.loads(sys.stdin.buffer.read(struct.unpack("<I", header)[0]))
            waiter = pending.pop(msg.get("id"), None)
            if waiter:
                waiter["reply"] = msg
                waiter["event"].set()
        # O Chrome fechou a conexão (navegador fechado ou extensão recarregada).
        # Só apaga o socket se ainda for o nosso (uma ponte nova pode já ter assumido).
        try:
            if bound and os.stat(SOCKET_PATH).st_ino == bound[0]:
                os.unlink(SOCKET_PATH)
        except OSError:
            pass
        os._exit(0)

    def handle(conn):
        with conn, conn.makefile("rwb") as f:
            try:
                req = json.loads(f.readline())
                msg_id = next(ids)
                waiter = pending[msg_id] = {"event": threading.Event()}
                send_to_chrome({"id": msg_id, "action": req["action"], "args": req.get("args") or {}})
                if waiter["event"].wait(TIMEOUT):
                    reply = waiter["reply"]
                else:
                    pending.pop(msg_id, None)
                    reply = {"ok": False, "error": "O Chrome não respondeu a tempo"}
            except Exception as e:  # pedido malformado
                reply = {"ok": False, "error": f"Pedido inválido: {e}"}
            f.write(json.dumps(reply).encode() + b"\n")
            f.flush()

    threading.Thread(target=read_from_chrome, daemon=True).start()

    try:
        os.unlink(SOCKET_PATH)
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    old_umask = os.umask(0o177)  # socket acessível só pelo seu usuário
    server.bind(SOCKET_PATH)
    os.umask(old_umask)
    bound.append(os.stat(SOCKET_PATH).st_ino)
    server.listen()
    while True:
        conn, _ = server.accept()
        threading.Thread(target=handle, args=(conn,), daemon=True).start()


# ---------- CLI ----------

def request(action, args=None):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(TIMEOUT + 2)
            s.connect(SOCKET_PATH)
            s.sendall(json.dumps({"action": action, "args": args or {}}).encode() + b"\n")
            with s.makefile("rb") as f:
                return json.loads(f.readline())
    except (FileNotFoundError, ConnectionRefusedError):
        return {"ok": False, "error": "Extensão não conectada (o Chrome está aberto com a YTM Control instalada?)"}
    except (socket.timeout, json.JSONDecodeError):
        return {"ok": False, "error": "Sem resposta da extensão"}
    except OSError as e:
        return {"ok": False, "error": f"Falha ao falar com a extensão: {e}"}


def describe(action, result):
    if action == "status":
        if not result.get("videoId"):
            return "Nada tocando"
        heart = {"LIKE": " ♥", "DISLIKE": " 👎"}.get(result.get("likeStatus"), "")
        state = "▶" if result.get("playing") else "⏸"
        return f"{state} {result.get('title')} — {result.get('artist')}{heart}"
    if action == "playlists":
        return "\n".join(f"{'✓' if p['contains'] else ' '} {p['title']}" for p in result["playlists"])
    return result.get("message") or "ok"


def notify(text, error=False):
    if shutil.which("notify-send"):
        icon = "dialog-error" if error else "youtube-music"
        subprocess.run(["notify-send", "-a", "YouTube Music", "-i", icon, "-t", "2500", "YouTube Music", text], check=False)


def main():
    p = argparse.ArgumentParser(prog="ytm", description="Controla o YouTube Music aberto no Chrome.")
    p.add_argument("--json", action="store_true", help="saída em JSON")
    p.add_argument("--notify", action="store_true", help="mostra o resultado como notificação do sistema")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="comando")
    for name, help_text in [
        ("like", "curtir / descurtir a música atual"),
        ("dislike", "marcar / desmarcar \"não gostei\""),
        ("play-pause", "tocar / pausar"),
        ("next", "próxima música"),
        ("previous", "música anterior"),
        ("status", "música atual"),
        ("playlists", "lista suas playlists (✓ = a música atual já está nela)"),
        ("pick", "abre o seletor de playlist na página"),
    ]:
        sub.add_parser(name, help=help_text)
    sub.add_parser("add", help="adiciona a música atual a uma playlist").add_argument("playlist", help="nome (ou parte do nome) ou ID")
    sub.add_parser("remove", help="remove a música atual de uma playlist").add_argument("playlist", help="nome (ou parte do nome) ou ID")
    sub.add_parser("slot", help="adiciona à playlist rápida N (configurada nas opções)").add_argument("n", type=int, choices=[1, 2, 3])
    a = p.parse_args()

    action, args = {
        "add": ("add-to-playlist", {"playlist": getattr(a, "playlist", None)}),
        "remove": ("remove-from-playlist", {"playlist": getattr(a, "playlist", None)}),
        "slot": ("slot", {"slot": getattr(a, "n", None)}),
        "pick": ("pick-playlist", {}),
    }.get(a.cmd, (a.cmd, {}))

    res = request(action, args)
    if a.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
    if not res.get("ok"):
        if not a.json:
            print(f"erro: {res.get('error')}", file=sys.stderr)
        if a.notify:
            notify(res.get("error", "erro"), error=True)
        sys.exit(1)
    text = describe(action, res.get("result") or {})
    if not a.json:
        print(text)
    if a.notify and action not in ("next", "previous", "play-pause", "pick-playlist"):
        notify(text)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1].startswith("chrome-extension://"):
        run_bridge()
    else:
        main()
